# Vyrthlands backend (server/index.js)
# Port the API + WebSocket server listens on (vite proxies /api and /ws here)
PORT=8081
# SQLite database file location (default: server/vyrthlands.db)
# DB_PATH=./server/vyrthlands.db

# Frontend (Vercel etc.): point the game at a hosted backend
# VITE_API_URL=https://your-backend.example.com
# Backend: lock CORS to your frontend origin in production
# ALLOWED_ORIGIN=https://yourgame.vercel.app

# Postgres (Neon / Railway). When set, the backend uses Postgres instead of sqlite.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Analytics (optional): StatsPilot project id from the StatsPilot dashboard
# (https://statspilot.vercel.app). When blank/unset, analytics are disabled —
# no tracking script is loaded. Must be set at build time (Vite bakes it in).
# VITE_STATSPILOT_ID=your-statspilot-project-id
